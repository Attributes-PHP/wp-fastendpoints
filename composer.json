{
    "name": "attributes-php/wp-fastendpoints",
    "type": "library",
    "description": "Fast to type. Fast to run WordPress REST endpoints",
    "keywords": [
        "wordpress",
        "fastest",
        "rest-api"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "attributes-php/validation": "^0.9",
        "php-di/invoker": "^2.0",
        "attributes-php/wp-fastendpoints-contracts": "^3.1",
        "attributes-php/serialization": "^0.3"
    },
    "suggest": {
        "attributes-php/wp-exceptions": "Allows throwing exceptions instead of returning WP_Error'ss"
    },
    "autoload": {
        "psr-4": {
            "Attributes\\Wp\\FastEndpoints\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Attributes\\Wp\\FastEndpoints\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Models"
        ],
        "files": [
            "tests/constants.php",
            "tests/wp-overrides.php"
        ]
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "brain/monkey": "2.*",
        "laravel/pint": "*",
        "pestphp/pest": "^1.23",
        "yoast/phpunit-polyfills": "^1.0 || ^4.0"
    },
    "scripts": {
        "lint": "./vendor/bin/pint --config pint.json",
        "test:lint": "./vendor/bin/pint --test",
        "test:coverage": "php -d error_reporting=24575 vendor/bin/pest --coverage",
        "test:unit": "php -d error_reporting=24575 vendor/bin/pest --colors=always",
        "test:integration": "npm run test:integration",
        "test:endtoend": "npm run test:endtoend",
        "test": [
            "@test:lint",
            "@test:unit",
            "@test:integration",
            "@test:endtoend"
        ]
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
