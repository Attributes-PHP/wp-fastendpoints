{
    "name": "attributes-php/wp-fastendpoints",
    "type": "library",
    "description": "Fast to type. Fast to run WordPress REST endpoints",
    "keywords": [
        "wordpress",
        "fastest",
        "rest-api"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "attributes-php/validation": "^0.9",
        "php-di/invoker": "^2.0",
        "attributes-php/wp-fastendpoints-contracts": "^3.1",
        "attributes-php/serialization": "^0.3"
    },
    "suggest": {
        "attributes-php/wp-exceptions": "Allows throwing exceptions instead of returning WP_Error'ss"
    },
    "autoload": {
        "psr-4": {
            "Attributes\\Wp\\FastEndpoints\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Attributes\\Wp\\FastEndpoints\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Models"
        ],
        "files": [
            "tests/constants.php",
            "tests/wp-overrides.php"
        ]
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "yoast/wp-test-utils": "^1.0",
        "roots/acorn": "^4.2",
        "brain/monkey": "2.*",
        "laravel/pint": "*",
        "pestphp/pest-plugin-parallel": "^1.2"
    },
    "scripts": {
        "lint": "./vendor/bin/pint --config pint.json",
        "env:start": "npx wp-env start",
        "env:stop": "npx wp-env stop",
        "env:destroy": "npx wp-env destroy",
        "setup:wp:6.0": "WP_ENV_CORE=https://wordpress.org/wordpress-6.0.18.zip npm run env:start -- --update",
        "setup:wp:6.1": "WP_ENV_CORE=https://wordpress.org/wordpress-6.1.16.zip npm run env:start -- --update",
        "setup:wp:6.2": "WP_ENV_CORE=https://wordpress.org/wordpress-6.2.15.zip npm run env:start -- --update",
        "setup:wp:6.3": "WP_ENV_CORE=https://wordpress.org/wordpress-6.3.14.zip npm run env:start -- --update",
        "setup:wp:6.4": "WP_ENV_CORE=https://wordpress.org/wordpress-6.4.14.zip npm run env:start -- --update",
        "setup:wp:6.5": "WP_ENV_CORE=https://wordpress.org/wordpress-6.5.14.zip npm run env:start -- --update",
        "setup:wp:6.6": "WP_ENV_CORE=https://wordpress.org/wordpress-6.6.11.zip npm run env:start -- --update",
        "setup:wp:6.7": "WP_ENV_CORE=https://wordpress.org/wordpress-6.7.11.zip npm run env:start -- --update",
        "setup:wp:6.8": "WP_ENV_CORE=https://wordpress.org/wordpress-6.8.12.zip npm run env:start -- --update",
        "setup:wp:6.9": "WP_ENV_CORE=https://wordpress.org/wordpress-6.9.11.zip npm run env:start -- --update",
        "setup:wp:7.0": "WP_ENV_CORE=https://wordpress.org/wordpress-7.0.8.zip npm run env:start -- --update",
        "setup:wp:7.1": "WP_ENV_CORE=https://wordpress.org/wordpress-7.1.4.zip npm run env:start -- --update",
        "setup:wp:latest": "npm run env:start -- --update",
        "test:lint": "./vendor/bin/pint --test",
        "test:coverage": "npx wp-env run tests-cli --env-cwd=wp-content/plugins/fastendpoints -- ./vendor/bin/pest --coverage --parallel",
        "test:unit": "npx wp-env run tests-cli --env-cwd=wp-content/plugins/fastendpoints -- ./vendor/bin/pest --colors=always --exclude-group=integration --parallel",
        "test:integration": "npx wp-env run tests-cli --env-cwd=wp-content/plugins/fastendpoints -- ./vendor/bin/pest --colors=always --group=integration",
        "test": [
            "@test:lint",
            "@test:unit",
            "@test:integration"
        ]
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "pestphp/pest-plugin": true
        }
    }
}
